      "#00938B",
      "#007C76",
      "#005F5A",
      "#0B3D39",
      "#0B2321"
    ],
    "orange": [
      "#FFF2E8",
      "#FFE0C4",
      "#FFC49B",
      "#FFA061",
      "#FF8C42",
      "#ED7526",
      "#D15E17",
      "#A94B10",
      "#7C360A",
      "#3A1B04"
    ],
    "ink": [
      "#E4F1EE",
      "#C6DED8",
      "#A2C9C1",
      "#7BAFA7",
      "#5B7B77",
      "#4E6B67",
      "#35605B",
      "#244F4A",
      "#163C38",
      "#0C2F2C"
    ],
    "brandStep": 5,
    "textSafe": {
      "teal": [
        7,
        8,
        9,
        10
      ],
      "orange": [
        8,
        9,
        10
      ],
      "ink": [
        5,
        6,
        7,
        8,
        9,
        10
      ]
    },
    "graphicScale": {
      "teal": [
        6
      ],
      "orange": [
        7
      ]
    },
    "outlinedStep": {
      "teal": 5,
      "orange": 5,
      "ink": 10
    }
  },
  "rules": {
    "orangeArea": {
      "nominal": 0.05,
      "hardCap": 0.1
    },
    "focus": {
      "widthPx": 2,
      "offsetPx": 2,
      "minContrast": 3.0
    },
    "disabledOpacity": 0.38,
    "textMinContrast": 4.5,
    "graphicsMinContrast": 3.0,
    "surfaceLadder": "recessed(-1) -> bg(0) -> surface(1) -> surface-2(2) -> surface-3(3)",
    "exceptions": [
      "AMOLED true black: AOD / wearable / battery-critical only"
    ]
  },
  "lightAndShadow": {
    "direction": "upper-left",
    "signals": [
      "surface tint",
      "top highlight",
      "hairline",
      "layered shadow",
      "ambient field glow"
    ],
    "shadowLayers": [
      {
        "name": "ambient",
        "blurPx": [
          40,
          64
        ],
        "offsetYPx": 12,
        "alpha": {
          "light": 0.1,
          "dark": 0.38
        }
      },
      {
        "name": "key",
        "blurPx": [
          14,
          20
        ],
        "offsetYPx": 4,
        "alpha": {
          "light": 0.09,
          "dark": 0.3
        }
      },
      {
        "name": "contact",
        "blurPx": [
          2,
          3
        ],
        "offsetYPx": 1,
        "alpha": {
          "light": 0.12,
          "dark": 0.36
        }
      }
    ],
    "depthLevels": [
      "L0 field",
      "L1 inset",
      "L2 card",
      "L3 sheet",
      "L4 top layer"
    ],
    "compositing": {
      "depth": "multiply",
      "light": "screen"
    },
    "rules": [
      "never invent a grey shadow hex",
      "no pure-black overlays except AMOLED",
      "gradients on field and sheen only, never on text"
    ]
  }
}
